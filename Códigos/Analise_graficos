CIDADES = data.frame(
  cidades=c("Bertioga","Cubatão","Santos") ,
  sólidos=c(BERTIOGA_S,CUBATÃO_S,SANTOS_S))

cat("Com o propósito de melhor entender as distribuições dos parâmetros chaves no cálculo do IQA, foram feitos os histogramas das seguintes variáveis; oxigênio dissolvido,
