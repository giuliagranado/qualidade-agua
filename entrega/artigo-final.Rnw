for (j in seq_along(param_short)) {
  nm <- param_short[j]
  dig <- ifelse(nm == "Fósforo Total", 3, ifelse(nm == "Sólidos Dissolvidos", 1, 2))
  pp <- resultados$p_pareado[j]
  pp_str <- ifelse(pp < 0.001, "$<0{,}001$", formatC(pp, format = "f", digits = 3, decimal.mark = ","))
  cat(sprintf("%s & %s & %s & %s & %s \\\\\n",
              param_labels[j],
              formatC(mean(bill[[nm]]), format = "f", digits = dig, decimal.mark = ","),
              formatC(mean(birp[[nm]]), format = "f", digits = dig, decimal.mark = ","),
              formatC(mean(cfug[[nm]]), format = "f", digits = dig, decimal.mark = ","),
              pp_str))
}
@
    \bottomrule
  \end{tabular}
  \par\smallskip
